<article
    class="comment{{#if level}} level-{{level}}{{/if}}"
    {{#if level}}style="--comment-level: {{level}};"{{/if}}
    id="comment-{{comment._id}}"
>
    <div class="comment-header">
        <img src="{{#if comment.authorPhoto}}{{comment.authorPhoto}}{{else}}/images/default-pfp.png{{/if}}" alt="{{#if comment.authorDisplay}}{{comment.authorDisplay}}{{else}}Anonymous{{/if}} profile picture" class="comment-avatar">

        <span class="comment-author">
            {{#if comment.authorDisplay}}
                {{comment.authorDisplay}}
            {{else}}
                Anonymous
            {{/if}}
        </span>

        <span class="comment-time">
            {{#if comment.createdAtLabel}}
                {{comment.createdAtLabel}}
            {{else}}
                {{#if comment.createdAt}}
                    {{comment.createdAt}}
                {{else}}
                    Just now
                {{/if}}
            {{/if}}
        </span>
        
        {{#if comment.updatedAtLabel}}
            <span class="comment-edited">(edited {{comment.updatedAtLabel}})</span>
        {{/if}}
    </div>

    <div class="comment-body" id="comment-body-{{comment._id}}">
        {{#if comment.content}}
            {{comment.content}}
        {{else}}
            No comment content yet.
        {{/if}}
    </div>

    <div class="comment-actions">
        <button class="action-btn" type="button">Reply</button>
        <span class="action-separator">&middot;</span>
        <button class="action-btn" type="button">Edit</button>
        <span class="action-separator">&middot;</span>
        <button class="action-btn delete" type="button">Delete</button>
    </div>
</article>
