<article
    class="comment{{#if level}} level-{{level}}{{/if}}"
    {{#if level}}style="--comment-level: {{level}};"{{/if}}
    id="comment-{{comment._id}}"
    data-author-id="{{comment.authorId}}"
>
    <div class="comment-header">
        <a href="/profile?id={{comment.authorId}}">
            <img src="{{#if comment.authorPhoto}}{{comment.authorPhoto}}{{else}}/images/default-pfp.png{{/if}}" 
                alt="{{#if comment.authorDisplay}}{{comment.authorDisplay}}{{else}}Anonymous{{/if}} profile picture" 
                class="comment-avatar">
        </a>

        <a href="/profile?id={{comment.authorId}}" class="comment-author">
            {{#if comment.authorDisplay}}
                {{comment.authorDisplay}}
            {{else}}
                Anonymous
            {{/if}}
        </a>

        <span class="comment-time">
            {{#if comment.createdAtLabel}}
                {{comment.createdAtLabel}}
            {{else}}
                {{#if comment.createdAt}}
                    {{comment.createdAt}}
                {{else}}
                    Just now
                {{/if}}
            {{/if}}
        </span>
        
        {{#if comment.isEdited}}
            <span class="comment-edited">(edited)</span>
        {{/if}}
    </div>

    <div class="comment-body" data-comment-body="{{comment._id}}">
        {{#if comment.content}}
            {{comment.content}}
        {{else}}
            No comment content yet.
        {{/if}}
    </div>

    <div class="comment-actions" data-comment-id="{{comment._id}}">
        <div class="owner-actions owner-only">
            <button class="action-btn reply-btn" type="button" data-comment-id="{{comment._id}}">Reply</button>
            <span class="action-separator">&middot;</span>
            <button class="action-btn edit-comment-btn" type="button" data-comment-id="{{comment._id}}">Edit</button>
            <span class="action-separator">&middot;</span>
            <button class="action-btn delete delete-comment-btn" type="button" data-comment-id="{{comment._id}}">Delete</button>
        </div>

        <div class="nonowner-actions not-owner">
            <button class="action-btn reply-btn" type="button" data-comment-id="{{comment._id}}">Reply</button>
        </div>
    </div>

    {{#if comment.replies}}
        <div class="comment-replies">
            {{#each comment.replies}}
                {{> comment-card comment=this level=../level}}
            {{/each}}
        </div>
    {{/if}}
</article>