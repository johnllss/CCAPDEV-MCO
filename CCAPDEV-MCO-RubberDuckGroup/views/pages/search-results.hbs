<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Results - The Rubber Duck Forums</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/post.css">
    <link rel="stylesheet" href="/css/notifications.css">
</head>

<body>
    {{> header}}

    <main>
        <section class="search-results-summary">
            <h2 class="post-header">
                Search Results{{#if searchQuery}} for "{{searchQuery}}"{{/if}}
            </h2>

            <div class="search-results-summary-text">
                {{#if posts.length}}
                    <p>{{posts.length}} matching posts found.</p>
                {{else}}
                    <p>Uh-oh! No matching posts found yet. Try another keyword.</p>
                {{/if}}
            </div>
        </section>

        <section class="filters-panel">
            <form class="filters-form" method="get" action="/search-results">
                <input type="hidden" name="q" value="{{searchQuery}}">

                <div class="filter-field filter-field-sort">
                    <label for="sort-dropdown">Sort by</label>
                    <select id="sort-dropdown" class="sort-dropdown" name="sort">
                        <option value="newest" {{#if filters.isNewest}}selected{{/if}}>Newest</option>
                        <option value="popular" {{#if filters.isPopular}}selected{{/if}}>Most Popular</option>
                        <option value="oldest" {{#if filters.isOldest}}selected{{/if}}>Oldest</option>
                    </select>
                </div>

                <div class="filter-field">
                    <label for="username-filter">Username</label>
                    <input id="username-filter" type="text" name="username" placeholder="Any username" value="{{filters.username}}">
                </div>

                <div class="filter-field">
                    <label for="date-from-filter">From</label>
                    <input id="date-from-filter" type="date" name="dateFrom" value="{{filters.dateFrom}}">
                </div>

                <div class="filter-field">
                    <label for="date-to-filter">To</label>
                    <input id="date-to-filter" type="date" name="dateTo" value="{{filters.dateTo}}">
                </div>

                <div class="filter-actions">
                    <button class="filter-btn" type="submit">Apply Filters</button>
                    <a class="filter-reset-link" href="{{resetSearchHref}}">Reset</a>
                </div>
            </form>

            {{#if filters.hasInvalidDateRange}}
                <p class="filter-feedback">The start date is later than the end date, so no posts can match that range.</p>
            {{/if}}
        </section>

        {{#if posts.length}}
            {{#each posts}}
                <div class="post-container">
                    {{> post-card 
                        post = this 
                        disableCardClick = false
                        hideVoteActions = true 
                        hideOwnerActions = true
                    }}
                </div>
            {{/each}}
        {{/if}}
    </main>

    <a class="floating-add-btn" href="/create-post">Create  +</a>

    {{> footer}}
    <script src="/js/notifications.js"></script>
    <script src="/js/common-utils.js"></script>
    <script src="/js/index.js"></script>
    <script src="/js/post.js"></script>
</body>

</html>
