<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Results - The Rubber Duck Forums</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/post.css">
</head>

<body>
    {{> header}}

    <main>
        <div class="post-container">

            <div class="post-card">

                <h2 class="post-header">
                    Search Results{{#if searchQuery}} for "{{searchQuery}}"{{/if}}
                </h2>

                <div class="post-body">
                    {{#if posts.length}}
                        <p>{{posts.length}} matching posts found.</p>
                    {{else}}
                        <p>Uh-oh! No matching posts found yet. Try another keyword.</p>
                    {{/if}}
                </div>

            </div>

        </div>

        {{#if posts.length}}
            {{#each posts}}
                <div class="post-container">
                    <div class="post-card">

                        <div class="post-top">

                            <div class="post-metadata">

                                <div class="profile-icon"></div>

                                <a class="post-owner-name" href="">
                                    {{#if author.username}}@{{author.username}}{{else}}@anonymous{{/if}}
                                </a>

                                <div class="post-timestamp">
                                    {{#if createdAtLabel}}{{createdAtLabel}}{{else}}Just now{{/if}}
                                </div>

                            </div>

                            <a href="/posts/{{_id}}"><button class="view-btn">VIEW</button></a>

                        </div>

                        <h2 class="post-header">{{#if title}}{{title}}{{else}}Untitled Post{{/if}}</h2>

                        {{#if content}}
                        <div class="post-body-container">
                            <div class="post-body">
                                <p>{{content}}</p>
                            </div>
                        </div>
                        {{/if}}

                    </div>

                </div>
            {{/each}}
        {{/if}}
    </main>

    {{> footer}}
</body>

</html>
