<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Results - The Rubber Duck Forums</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/post.css">
</head>

<body>
    {{> header}}

    <main>
        <section class="search-results-summary">
            <h2 class="post-header">
                Search Results{{#if searchQuery}} for "{{searchQuery}}"{{/if}}
            </h2>

            <div class="search-results-summary-text">
                {{#if posts.length}}
                    <p>{{posts.length}} matching posts found.</p>
                {{else}}
                    <p>Uh-oh! No matching posts found yet. Try another keyword.</p>
                {{/if}}
            </div>
        </section>

        {{#if posts.length}}
            {{#each posts}}
                <div class="post-container">
                    {{> post-card 
                        post = this 
                        disableCardClick = false
                        hideVoteActions = true 
                        hideOwnerActions = true
                    }}
                </div>
            {{/each}}

        {{else}}
            <div class="post-container">

                <div class="post-card">

                    <div class="post-top">
                        <div class="post-metadata">
                            <div class="profile-icon"></div>
                            <a class="post-owner-name" href="">@RubberDuckForums</a>
                            <div class="post-timestamp">just now</div>
                        </div>
                    </div>

                    <h2 class="post-header">No matching posts yet.</h2>

                    <div class="post-body-container">
                        <div class="post-body">
                            <p>Try another keyword to find posts in the forum.</p>
                        </div>
                    </div>

                </div>

            </div>
        {{/if}}
    </main>

    <a class="floating-add-btn" href="/create-post">Create  +</a>

    {{> footer}}
    <script src="/js/index.js"></script>
    <script src="/js/post.js"></script>
</body>

</html>