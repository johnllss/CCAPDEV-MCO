<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post - The Rubber Duck Forums</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/post.css">
</head>

<body>
    {{> header}}

    {{!-- NOTE: Only post body can be edited --}}

    <main>
        <div class="create-post-container">

            <div class="create-post-box">

                <div class="create-post-content-container">
                    <h2 class="create-post-header">Edit Post</h2>

                    <div class="create-post-title-container">
                        <div id="title-input" class="edit-post-title" aria-hidden="true">{{post.title}}</div>
                    </div>

                    <div class="post-body-container">
                        <textarea id="post-body" class="create-post-body" placeholder="Body">{{post.content}}</textarea>
                    </div>
                </div>

            </div>
        </div>

        <div class="create-post-actions-container">
            <button id="cancel-button" class="create-post-cancel-button">Cancel</button>            
            <button id="save-button" class="create-post-publish-button">Save Changes</button>
        </div>
    </main>

    {{> footer}}

    <script src="/js/edit-post.js"></script>
</body>

</html>
