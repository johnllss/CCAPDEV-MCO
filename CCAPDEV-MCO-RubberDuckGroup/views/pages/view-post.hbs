<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        {{#if post.title}}
            {{post.title}} - The Rubber Duck Forums
        {{else}}
            View Post - The Rubber Duck Forums
        {{/if}}
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap"rel="stylesheet">

    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/post.css">
    <link rel="stylesheet" href="/css/comments.css">
</head>
<body>
    {{> header}}

    <main>
        <div class="post-container">
            {{> post-card 
                post = post 
                isOwner = isOwner 
                disableCardClick = true
            }}
        </div>

        <section id="comments-section">
            <div class="comments-header">Comments ({{commentsCount}})</div>

            <div class="add-comment-form">
                <textarea id="new-comment-text" placeholder="Write a comment..."></textarea>
                <button class="form-submit-btn" type="button">Post Comment</button>
            </div>

            <div class="comments-list" id="comments-list">
                {{#if commentsCount}}
                    {{#each comments}}
                        {{> comment-card comment=this level=0}}
                    {{/each}}
                {{else}}
                    <p class="comment-body">No comments yet. Start the discussion.</p>
                {{/if}}
            </div>
        </section>
    </main>

    {{> footer}}

    <script src="/js/view-post.js"></script>
    <script src="/js/post.js"></script>
</body>
</html>
