<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile</title>
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    {{> header}}

    <main>
        <div class="profile-container">
            <div class="profile-header-container">
                <div class="profile-left">
                    <img id="profilepic" src="/images/sample.jpg" alt="display picture">
                    <p class="user-quote" id="userquote"></p>
                </div>

                <div class="profile-right">
                    <h2 class="username" id="username">Username</h2>
                    <h3 class="fullname" id="fullname">FullName</h3>

                    <div class="profile-stats">
                        <div class="stat">
                            <span class="stat-label">Total Posts</span>
                            <span class="stat-value" id="total-posts">-</span>
                        </div>

                        <div class="stat">
                            <span class="stat-label">D-Day</span>
                            <span class="stat-value" id="join-date">-</span>
                        </div>

                        <div class="stat">
                            <span class="stat-label">Total Replies</span>
                            <span class="stat-value" id="total-replies">-</span>
                        </div>
                    </div>

                    <a href="/edit-profile" class="editbtn" id="editBtn">Edit Profile</a>
                </div>
            </div>

            <div class="profile-content">
                <section class="profile-section">
                    <h2>About Me</h2>
                    <div class="aboutme-container">
                        <p class="aboutme" id="aboutMe"></p>
                    </div>
                </section>

                <section class="profile-section">
                    <h2>Recent Activity</h2>

                    <ul class="activity-list" id="activitylist">
                        <li>
                            No activity yet.
                        </li>
                    </ul>
                </section>
            </div>
        </div>
    </main>

    {{> footer}}

    <script src="/js/common-utils.js"></script>
    <script src="/js/profile.js"></script>
</body>

</html>
