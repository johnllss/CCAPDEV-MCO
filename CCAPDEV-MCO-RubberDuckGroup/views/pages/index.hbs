<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Rubber Duck Forums</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/post.css">
</head>

<body>
    {{> header}}

    <main>
        {{#if posts.length}}
        {{#each posts}}
        <div class="post-container">

            <div class="post-card" data-postid="{{_id}}" data-upvotes="{{upvotes}}" data-downvotes="{{downvotes}}">

                <div class="post-top">

                    <div class="post-metadata">

                        <div class="profile-icon">
                            <a href="/profile{{#if authorId}}?id={{authorId}}{{/if}}">
                                <img src="{{authorPhoto}}" alt="@{{authorUsername}}'s profile">
                            </a>
                        </div>

                        <a class="post-owner-name" href="/profile{{#if authorId}}?id={{authorId}}{{/if}}">
                            {{#if authorUsername}}@{{authorUsername}}{{else}}@anonymous{{/if}}
                        </a>

                        <div class="post-timestamp">
                            {{#if createdAtLabel}} {{createdAtLabel}} {{else}} just now {{/if}}
                            {{#if updatedAtLabel}} <span class="post-edit-timestamp"> (edited {{updatedAtLabel}})</span>
                            {{/if}}
                        </div>

                    </div>

                    <a href="/posts/{{_id}}/view"><button class="view-btn">VIEW</button></a>

                </div>

                <h2 class="post-header">{{#if title}} {{title}} {{else}} Untitled Post {{/if}}</h2>

                {{#if content}}
                <div class="post-body-container">

                    <div class="post-image"><img src="{{image}}"></div>

                    <div class="post-body">
                        <p>{{body}}</p>
                    </div>

                </div>
                {{/if}}

                <div class="post-actions">

                    <div class="post-vote-actions">

                        <button class="upvote-button {{#if isUpvoted}}voted{{/if}}" type="button"
                            aria-label="Upvote post">
                            <img class="upvote-icon"
                                src="{{#if isUpvoted}}/images/upvote-fill.png{{else}}/images/upvote-outline.png{{/if}}"
                                alt="Upvote">
                        </button>

                        <span class="vote-count">{{votes}}</span>

                        <button class="downvote-button {{#if isDownvoted}}voted{{/if}}" type="button"
                            aria-label="Downvote post">
                            <img class="downvote-icon"
                                src="{{#if isDownvoted}}/images/downvote-fill.png{{else}}/images/downvote-outline.png{{/if}}"
                                alt="Downvote">
                        </button>

                    </div>

                </div>

            </div>

        </div>

        {{/each}}

        {{else}}

        <div class="post-container">

            <div class="post-card">

                <div class="post-top">

                    <div class="post-metadata">

                        <div class="profile-icon"></div>
                        <a class="post-owner-name" href="">@RubberDuckForums</a>
                        <div class="post-timestamp">just now</div>

                    </div>

                </div>

                <h2 class="post-header">No recent posts yet.</h2>

                <div class="post-body-container">
                    <div class="post-body">
                        <p>Recent posts will appear here once the community starts posting.</p>
                    </div>
                </div>

            </div>

        </div>

        {{/if}}
    </main>

    <div class="floating-add-btn"><a href="/create-post">+</a></div>

    {{> footer}}

    <script src="/js/index.js"></script>
    <script src="/js/post.js"></script>
</body>

</html>