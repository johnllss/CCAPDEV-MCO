<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Logged Out | The Rubber Duck Forums</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/logout.css">
</head>

<body>
    <main class="logout-page">
        <section class="logout-visual">
            <img src="/images/highfive.png" alt="Two people high fiving each other while smiling.">
        </section>

        <section class="logout-content">
            <a class="brand" href="/">
                <img src="/images/rubber-duck.png" alt="Rubber duck logo">
                <span>The Rubber Duck Forums</span>
            </a>

            <div class="logout-copy">
                <h1>Goodbye for<br>now!</h1>
                <p>You have successfully logged out.</p>
            </div>

            <p class="logout-footer">
                Missed us already? <a href="/login">Log In again!</a>
            </p>
        </section>
    </main>

    <script src="/js/logout.js"></script>
</body>

</html>
